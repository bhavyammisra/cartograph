# Copy this file to .env and fill in what you use. .env is never committed.

# Postgres with pgvector (docker compose up -d db)
DATABASE_URL=postgresql://cartograph:cartograph@127.0.0.1:5432/cartograph

# Ollama for the local agent (default shown); inside Docker this is set to the host machine
OLLAMA_URL=http://localhost:11434

# Optional: a stronger free model on Groq for comparisons (cartograph eval --llm gpt-oss-120b)
GROQ_API_KEY=
